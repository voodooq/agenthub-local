# AgentHub Local 环境变量配置模板
TZ=Asia/Shanghai
LOG_LEVEL=INFO

# 后端持久化路径（容器内路径）
DB_PATH=/app/data/agenthub_local.db
PROFILE_PATH=/app/data/profile.md

# 429 故障转移重试次数与默认冷却时长（秒）
AUTO_FAILOVER_RETRY=3
DEFAULT_COOLDOWN_SECONDS=60

# Google OAuth 2.0 客户端凭据（可选，内置默认开发凭据，支持自定义覆盖）
# GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret

# 前端反代后端地址（Docker 网络内使用 http://backend:8686，本地调试使用 http://localhost:8686）
BACKEND_URL=http://backend:8686