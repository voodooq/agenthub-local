{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OfficeExcelInput",
  "type": "object",
  "required": ["sheets"],
  "properties": {
    "output_path": {
      "type": "string",
      "default": "output/sheets/report.xlsx",
      "description": "输出 .xlsx 文件路径（建议位于 output/sheets/）"
    },
    "sheets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "columns", "rows"],
        "properties": {
          "name": { "type": "string" },
          "title": { "type": "string" },
          "group_headers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["label", "span"],
              "properties": {
                "label": { "type": "string" },
                "span": { "type": "integer", "minimum": 1 }
              }
            }
          },
          "columns": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["key", "label"],
              "properties": {
                "key": { "type": "string" },
                "label": { "type": "string" },
                "type": { "type": "string", "enum": ["text", "integer", "currency", "number", "percent"] },
                "agg": { "type": "string", "enum": ["SUM", "AVERAGE", "NONE"] },
                "formula_template": { "type": "string" }
              }
            }
          },
          "rows": {
            "type": "array",
            "items": { "type": "object" }
          }
        }
      }
    }
  }
}
