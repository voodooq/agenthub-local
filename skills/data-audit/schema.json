{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DataAuditInput",
  "type": "object",
  "required": ["input_path"],
  "properties": {
    "input_path": {
      "type": "string",
      "description": "待审计的 CSV 或 Excel 文件路径"
    },
    "sheet_name": {
      "type": ["string", "integer"],
      "default": 0,
      "description": "Excel 工作表名称或索引"
    },
    "key_columns": {
      "type": "array",
      "items": { "type": "string" },
      "default": [],
      "description": "用于主键唯一性检测的列名列表"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["expr"],
        "properties": {
          "name": { "type": "string" },
          "expr": { "type": "string" }
        }
      },
      "default": [],
      "description": "跨列逻辑校验规则表达式列表"
    },
    "output_dir": {
      "type": "string",
      "default": "output/audit",
      "description": "审计报告输出目录"
    },
    "report_name": {
      "type": "string",
      "description": "可选自定义输出文件名前缀"
    }
  }
}
